PORT=3000
HOST=0.0.0.0
# Orígenes web permitidos separados por coma (protocolo + dominio, sin rutas).
# Vacío permite cualquier origen; configurar aquí los dominios reales de producción.
# CORS_ORIGIN=https://app.ejemplo.com,https://www.app.ejemplo.com
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@127.0.0.1:5432/turnos_camiones
# DATABASE_URL se usa solo para exportar nuevamente desde PostgreSQL histórico.
DATABASE_SSL=false
# Conexión del backend activo a MySQL/MariaDB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=turnos_camiones
MYSQL_USER=usuario
MYSQL_PASSWORD=contraseña
MYSQL_POOL_MAX=10
PUBLIC_BASE_URL=http://localhost:3000
TRACKING_BASE_URL=http://localhost:3000
QR_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO
QR_LINK_VALID_SECONDS=30
PENDING_TURN_MINUTES=20

# Firebase Cloud Messaging; habilitar FCM y usar una cuenta de servicio del proyecto.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./notificaciones-fcm.json

TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_DEFAULT_COUNTRY_CODE=+54

TTS_ENABLED=false
LLAMADOR_SERVICE_URL=http://127.0.0.1:8000/llamar
BOCINA_POLL_ENABLED=true
TTS_CLOUD_ENABLED=false
TTS_OPENAI_API_KEY=
TTS_OPENAI_MODEL=tts-1
TTS_OPENAI_VOICE=nova

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=turnos_camiones
MYSQL_USER=root
MYSQL_PASSWORD=